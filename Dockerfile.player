FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    AWS_REGION=us-west-2
WORKDIR /app
COPY pyproject.toml README.md ./
COPY gnomic ./gnomic
RUN pip install --no-cache-dir .
ARG GNOMIC_PERSONA=ivan
ENV GNOMIC_PERSONA=${GNOMIC_PERSONA}
CMD ["python", "-m", "gnomic.players.llm"]
